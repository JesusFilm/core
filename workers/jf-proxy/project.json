{
  "name": "jf-proxy",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "workers/jf-proxy/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "wrangler dev --port=8787",
        "cwd": "workers/jf-proxy"
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{workspaceRoot}/coverage/workers/jf-proxy"],
      "options": {
        "reportsDirectory": "../../coverage/workers/jf-proxy",
        "config": "workers/jf-proxy/vite.config.ts",
        "configFile": "workers/jf-proxy/vitest.config.mts"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "wrangler deploy --env=stage",
        "cwd": "workers/jf-proxy"
      },
      "configurations": {
        "production": {
          "command": "wrangler deploy --env=prod"
        }
      }
    }
  }
}
