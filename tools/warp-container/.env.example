# Copy to .env (git-ignored). Aurora cluster writer endpoints:
#   aws rds describe-db-clusters --query 'DBClusters[].[DBClusterIdentifier,Endpoint]' --output text
PROD_PG_ENDPOINT=
STAGE_PG_ENDPOINT=
# Host loopback port for the SOCKS5/HTTP proxy (1080 is taken by the core devcontainer).
WARP_PROXY_PORT=11080
