{
  "name": "api-auth",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apis/api-auth/src",
  "projectType": "application",
  "implicitDependencies": ["prisma-auth"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^prisma-generate"],
      "outputs": ["{workspaceRoot}/dist/apis/api-auth"],
      "options": {
        "command": "pnpm exec esbuild apis/api-auth/src/index.ts --bundle --platform=node --target=node24 --format=esm --banner:js=\"import { createRequire } from 'node:module';const require = createRequire(import.meta.url);\" --outfile=dist/apis/api-auth/main.mjs"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsx watch apis/api-auth/src/index.ts"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node dist/apis/api-auth/main.mjs"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["apis/api-auth/**/*.ts"]
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm tsc7 -p apis/api-auth/tsconfig.ts7.json"
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "configFile": "apis/api-auth/vitest.config.mts"
      },
      "outputs": ["{workspaceRoot}/coverage/apis/api-auth"]
    },
    "test-coverage": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{workspaceRoot}/coverage/apis/api-auth"],
      "options": {
        "command": "pnpm exec tsx apis/api-auth/test/runCoverage.ts"
      }
    },
    "codecov": {
      "executor": "nx:run-commands",
      "options": {
        "command": "codecov -f coverage/apis/api-auth/cobertura-coverage.xml -F apps.api-auth"
      }
    }
  }
}
