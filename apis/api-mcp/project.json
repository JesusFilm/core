{
  "name": "api-mcp",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apis/api-mcp/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apis/api-mcp"],
      "options": {
        "command": "pnpm exec esbuild apis/api-mcp/src/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/apis/api-mcp/main.cjs"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm exec tsx watch apis/api-mcp/src/index.ts" }
    },
    "start": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": { "command": "node dist/apis/api-mcp/main.cjs" }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": { "lintFilePatterns": ["apis/api-mcp/**/*.ts"] }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm tsc7 -p apis/api-mcp/tsconfig.ts7.json" }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": { "configFile": "apis/api-mcp/vitest.config.mts" }
    }
  }
}
