generator client {
  provider = "prisma-client"
  output   = "../src/__generated__/client"
}

datasource db {
  provider = "postgresql"
}

model AuthEnvironment {
  id        String @id
  binding   String
}

model OAuthArtifact {
  model      String
  id         String
  payload    Json
  grantId    String?
  userCode   String?
  uid        String?
  expiresAt  DateTime?
  consumedAt DateTime?

  @@id([model, id])
  @@index([grantId])
  @@index([model, userCode])
  @@index([model, uid])
  @@index([expiresAt])
}

model AgentConnection {
  id                  String   @id @default(uuid())
  grantId             String   @unique
  userId              String
  clientId            String
  environment         String
  mode                String
  journeyIds          String[]
  version             Int      @default(1)
  expiresAt           DateTime
  approvedAt          DateTime
  revokedAt           DateTime?
  firebaseAuthTime     Int
  firebaseCreatedAt   String
  credentialsPending Boolean @default(false)

  @@index([userId, clientId])
  @@index([expiresAt])
}

model ConsentReview {
  interactionId String   @id
  userId        String
  clientId      String
  csrfHash      String
  reviewHash    String?
  mode          String?
  duration      String?
  journeyIds    String[]
  approvedAt    DateTime?
  expiresAt     DateTime?
  validUntil    DateTime
  consumedAt    DateTime?
  generation    Int      @default(0)
  connectionId  String?
  connectionVersion Int?
}

model AgentRenewalReview {
  id                String   @id
  connectionId      String
  connectionVersion Int
  userId            String
  clientId          String
  sessionHash       String
  duration          String
  previewExpiresAt  DateTime
  validUntil        DateTime
  consumedAt        DateTime?

  @@index([validUntil])
}

model AuthorizationGate {
  id         String  @id
  generation Int     @default(0)
  open       Boolean @default(true)
}

model SecurityAudit {
  id         String   @id @default(uuid())
  action     String
  outcome    String
  occurredAt DateTime
  expiresAt  DateTime
  userId     String?
  clientId   String?
  journeyIds String[]

  @@index([expiresAt])
}

model ReadPermit {
  id             String   @id @default(uuid())
  connectionId   String
  grantVersion   Int
  requestId      String
  requestHash    String
  stage          String
  executor       String
  executorId     String
  journeyIds     String[]
  gates          Json
  status         String   @default("prepared")
  preparedAt     DateTime
  acceptedAt     DateTime?
  settledAt      DateTime?
  outputHash     String?

  @@index([connectionId, status])
  @@index([requestId, stage])
  @@index([status, settledAt])
  @@index([status, preparedAt])
}

model AgentAccessReview {
  id                String   @id
  connectionId      String
  connectionVersion Int
  userId            String
  clientId          String
  sessionHash       String
  mode              String
  journeyIds        String[]
  validUntil        DateTime
  consumedAt        DateTime?

  @@index([validUntil])
}

model ConnectionChange {
  id              String   @id @default(uuid())
  connectionId    String
  expectedVersion Int
  version         Int
  kind            String
  mode            String
  journeyIds      String[]
  gateGeneration  Int
  status          String   @default("pending")
  requestedAt     DateTime
  completedAt     DateTime?

  @@unique([connectionId, expectedVersion])
  @@index([status])
}

// Owning history/result features consume this durable intent after draining.
model ConnectionHistoryPurge {
  connectionId String   @id
  changeId     String   @unique
  requestedAt  DateTime
  completedAt  DateTime?
}

// A per-request sender's explicit terminal evidence, never a lease or heartbeat.
model ReadExecutor {
  id        String   @id
  executor  String
  fencedAt  DateTime?
}

// The owner reports completion only after its durable mutation receipt or fence.
model PermissionChange {
  id          String   @id
  owner       String
  intentHash  String
  gateIds     String[]
  gates       Json
  status      String   @default("pending")
  outcome     String?
  requestedAt DateTime
  completedAt DateTime?

  @@index([status])
}

// A recreated Firebase UID cannot inherit the retired account's authority.
model RetiredAccount {
  userId    String   @id
  retiredAt DateTime
}
