{
  "name": "arclight",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/arclight",
  "projectType": "application",
  "tags": ["doppler_config:stg_dev"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cp -r libs/locales apps/arclight/public",
          "nx _build arclight",
          "cp apps/arclight/next-logger.config.js dist/apps/arclight/next-logger.config.js"
        ],
        "parallel": false
      },
      "configurations": {
        "production": {
          "commands": [
            "cp -r libs/locales apps/arclight/public",
            "CI=true nx _build arclight --configuration=production",
            "cp apps/arclight/next-logger.config.js dist/apps/arclight/next-logger.config.js"
          ]
        }
      }
    },
    "_build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/arclight"],
      "options": {
        "commands": [
          "cd apps/arclight && NX_NEXT_OUTPUT_PATH=dist/apps/arclight pnpm exec next build --webpack",
          "node tools/scripts/create-arclight-dist-package-json.js",
          "rm -rf dist/apps/arclight/public && cp -rL apps/arclight/public dist/apps/arclight/public",
          "cp apps/arclight/next.config.dist.js dist/apps/arclight/next.config.js"
        ],
        "parallel": false
      },
      "configurations": {
        "production": {}
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "VERCEL_PROJECT_ID=$ARCLIGHT_VERCEL_PROJECT_ID pnpm exec vercel pull --environment=preview --token=$VERCEL_TOKEN",
          "echo \"VERCEL_ENV=\\\"$NEXT_PUBLIC_VERCEL_ENV\\\"\" >> .vercel/.env.preview.local",
          "echo \"VERCEL_GIT_COMMIT_SHA=\\\"$NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA\\\"\" >> .vercel/.env.preview.local",
          "pnpm exec vercel build",
          "VERCEL_PROJECT_ID=$ARCLIGHT_VERCEL_PROJECT_ID pnpm exec vercel deploy --prebuilt --token=$VERCEL_TOKEN --archive=tgz > apps/arclight/.vercel-url"
        ],
        "parallel": false
      },
      "configurations": {
        "production": {
          "commands": [
            "VERCEL_PROJECT_ID=$ARCLIGHT_VERCEL_PROJECT_ID pnpm exec vercel pull --environment=production --token=$VERCEL_TOKEN",
            "echo \"VERCEL_ENV=\\\"$NEXT_PUBLIC_VERCEL_ENV\\\"\" >> .vercel/.env.production.local",
            "echo \"VERCEL_GIT_COMMIT_SHA=\\\"$NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA\\\"\" >> .vercel/.env.production.local",
            "pnpm exec vercel build --prod",
            "VERCEL_PROJECT_ID=$ARCLIGHT_VERCEL_PROJECT_ID pnpm exec vercel deploy --prebuilt --prod --token=$VERCEL_TOKEN --archive=tgz > apps/arclight/.vercel-url"
          ]
        }
      }
    },
    "upload-sourcemaps": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "pnpm dlx @datadog/datadog-ci@5.8.0 sourcemaps upload dist/apps/arclight/.next/static --service=arclight --release-version=$GIT_COMMIT_SHA --minified-path-prefix=/_next/static/"
        ],
        "parallel": false
      }
    },
    "vercel-alias": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "pnpm exec vercel alias set $(cat apps/arclight/.vercel-url) arclight-$PR_NUMBER-jesusfilm.vercel.app --token=$VERCEL_TOKEN --scope=jesusfilm",
          "echo \"https://arclight-$PR_NUMBER-jesusfilm.vercel.app\" > apps/arclight/.vercel-url"
        ],
        "parallel": false
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "command": "pnpm exec next dev --webpack -p 4600",
        "cwd": "apps/arclight"
      },
      "configurations": {
        "development": {},
        "production": {
          "command": "pnpm exec next start -p 4600",
          "cwd": "dist/apps/arclight"
        }
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "configFile": "apps/arclight/vitest.config.mts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "cache": true,
        "cacheLocation": ".cache/arclight/eslint",
        "cacheStrategy": "content"
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm tsc7 -p apps/arclight/tsconfig.ts7.json"
      }
    },
    "fetch-secrets": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "DOPPLER_TOKEN=$DOPPLER_ARCLIGHT_TOKEN doppler secrets download --no-file --format=env-no-quotes --project arclight > apps/arclight/.env"
          }
        ]
      }
    },
    "extract-translations": {
      "executor": "nx:run-commands",
      "options": {
        "commands": []
      }
    }
  }
}
