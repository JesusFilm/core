+def core_remote_allowed(item):
+    # A rerun retains its old workflow. Keep pre-rollout runs local even after
+    # new workflows support both node names. Missing/invalid metadata fails closed.
+    try:
+        cutoff = datetime.fromisoformat(CORE_REMOTE_SINCE.read_text().strip())
+        created = datetime.fromisoformat(item['created_at'])
+        return (cutoff.utcoffset() is not None and created.utcoffset() is not None
+                and created.astimezone(timezone.utc) >= cutoff.astimezone(timezone.utc))
+    except (OSError, ValueError, TypeError, KeyError):
+        return False
+
+
+def core_slot(state, *, allow_remote=False):
+    # Prefer the node with fewer active CI guests; ties favor the less busy
+    # production host, jfp01. Capacity and template readiness remain per-node.
+    nodes = sorted((node for node in TEMPLATES if allow_remote or node == 'jfp00'), key=lambda node: (
+        sum(SLOTS[slot][4] == node for slot in state), node != 'jfp01'))
+    for node in nodes:
+        free = [slot for slot in SLOTS if slot not in state and SLOTS[slot][4] == node]
+        if not free or not capacity_ready(node, state, PUBLIC_REPOSITORY):
+            continue
+        try:
+            config = node_command(node, 'qm', 'config', str(TEMPLATES[node]))
+        except Exception as exc:
+            LOG.warning('core template unavailable on %s: %s', node, type(exc).__name__)
+            continue
+        if any(line.startswith('lock:') for line in config.splitlines()):
+            continue
+        return min(free, key=int)
+    return None
+
