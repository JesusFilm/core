#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Agent-gated lint (ENG-3691): agents must lint what they push; manual human
# pushes are not gated (run `pnpm lint:changed` yourself anytime). Escape
# hatch for emergencies: `git push --no-verify`.
#
# Claude Code and Cursor each set one known marker. Codex is matched on the
# CODEX_ prefix instead of specific names: the documented ones (CODEX_SANDBOX,
# CODEX_SESSION_ID) are conditional — CODEX_SANDBOX is only set while the
# sandbox is active — and nobody here runs Codex to confirm the full set. A
# missed name would fail silently by leaving those pushes ungated, so match
# the namespace rather than guess its members. A false positive only means
# running a lint we wanted to run anyway.
if [ -n "${CLAUDECODE:-}" ] ||
  [ -n "${CURSOR_AGENT:-}" ] ||
  env | grep -q '^CODEX_'; then
  tools/scripts/lint-changed.sh --committed
fi
