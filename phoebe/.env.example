# Phoebe environment — scaffolded by `phoebe init`. Copy to `.env` and fill in.
#
# Two credential arms are supported. Set one:
#   pat arm  Per-tenant GH_TOKEN below — one hand-minted fine-grained PAT per repo.
#   app arm  GH_APP_ID + GH_APP_PRIVATE_KEY below — one GitHub App installation
#            mints tokens automatically for every tenant.
#
# The provider key is required only for whichever agent you actually run — set the
# one that matches your `defaultProvider` (or `PHOEBE_AGENT` at runtime).
#
# Which engine version runs is NOT set here: it is `engine.ref` in
# phoebe.config.ts, which `boot` re-reads while the container runs.

# --- pat arm: per-tenant PAT (leave blank when using the app arm below) ---
GH_TOKEN=

# --- app arm: GitHub App key (alternative to a per-tenant GH_TOKEN per tenant) ---
# Deployment-level and supervisor-only: GH_APP_* is on no engine-child allowlist,
# so the private key never reaches an agent. GH_APP_PRIVATE_KEY is the PEM from
# the App's settings page, verbatim.
# GH_APP_ID=
# GH_APP_PRIVATE_KEY=

# --- Provider keys (set the one you use) ---
ANTHROPIC_API_KEY=
CURSOR_API_KEY=
OPENAI_KEY=
# Claude Pro/Max subscription (the configured arm for core): paste the token
# from `claude setup-token` here. phoebe.config.ts forwards this var, not
# ANTHROPIC_API_KEY, to the claude provider.
CLAUDE_CODE_OAUTH_TOKEN=

# --- Sentry work kind (optional) ---
# Only for a tenant that declares the `sentry` catalog kind (docs/work-kinds.md).
# A Sentry auth token with the `event:read` scope; the same name sentry-cli uses.
# SENTRY_AUTH_TOKEN=

# --- Multiple Phoebe containers on one host (usually not needed) ---
# One container can serve many repos as tenants (a workspace root and its
# declared children), so you rarely need a second instance. If you do run
# more than one Phoebe container here, set this uniquely per instance — otherwise
# they share one phoebe-data volume and work each other's clones.
# COMPOSE_PROJECT_NAME=phoebe-your-deployment

# --- Runtime toggles (optional) ---
PHOEBE_AGENT=claude
PHOEBE_MODEL=claude-sonnet-5-5
# PHOEBE_POLL_INTERVAL_MS=300000
# How often `boot` checks the config and the tracked engine ref (default 60000).
# PHOEBE_RECONCILE_INTERVAL_MS=60000

# --- Local engine checkout (compose.local.yml only, development) ---
# PHOEBE_ENGINE_MOUNT=/path/to/phoebe
